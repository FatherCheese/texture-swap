{
  "schemaVersion": 1,
  "id": "textureswap",
  "version": "${version}",

  "name": "Texture Swap",
  "description": "A texture pack util, allowing for named items to swap textures.",
  "authors": [
    "Cookie Cakes"
  ],
	"contributors": [
		"UselessBullets (coding help)"
	],
  "contact": {
    "homepage": "https://github.com/FatherCheese/texture-swap",
		"issues": "https://github.com/FatherCheese/texture-swap/issues",
    "sources": "https://github.com/Turnip-Labs/bta-example-mod"
  },

  "license": "CC0-1.0",
	"icon": "icon.png",

  "environment": "*",
  "entrypoints": {
		"main": [
			"cookie.textureswap.TextureSwap"
		],
		"client": [
			"cookie.textureswap.TextureSwapClient"
		]
	},
  "mixins": [
		"textureswap.mixins.json"
  ],

  "depends": {
		"minecraft": "^7.2-beta",
		"fabricloader": ">=0.15.5"
  },
  "suggests": {
  }
